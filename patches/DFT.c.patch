--- upstream/src/DFT.c
+++ firmware/audioclock_5/src/DFT.c
@@ -537,9 +537,12 @@
   N >>= 1;
   while(N-- > 1)
     {
+      /* TEENSY PORT: magnitude only. Neither caller of rdft_rect_to_polar()
+         (btt_onset_tracking, rdft_real_generalized_autocorrelation) reads
+         the phase, so the double-precision atan2() was pure cost. */
       temp = *real;
-      *real = hypot(*real, *imag);
-      *imag = atan2(*imag, temp);
+      *real = sqrtf(temp*temp + (*imag)*(*imag));
+      *imag = 0.0f;
       ++real, --imag;
     }
 }
@@ -648,13 +651,22 @@
   rdft_real_forward_dft(real, N);
   rdft_rect_to_polar(real, N);
   
-  real[0] = pow(real[0], exponent);
-  for(i=1; i<n_over_2; i++)
-    {
-      real[i] = pow(real[i], exponent);
-      real[N-i-1] = 0;
+  /* TEENSY PORT: the default exponent is 0.5, i.e. a square root taken
+     through double-precision pow(). Single-precision fast path. */
+  if(exponent == 0.5)
+    {
+      real[0] = sqrtf(real[0]);
+      for(i=1; i<n_over_2; i++)
+        { real[i] = sqrtf(real[i]); real[N-i-1] = 0; }
+      real[n_over_2] = sqrtf(real[n_over_2]);
+    }
+  else
+    {
+      real[0] = powf(real[0], (float)exponent);
+      for(i=1; i<n_over_2; i++)
+        { real[i] = powf(real[i], (float)exponent); real[N-i-1] = 0; }
+      real[n_over_2] = powf(real[n_over_2], (float)exponent);
     }
-  real[n_over_2] = pow(real[n_over_2], exponent);
   
