     }
   
   self->beat_period_oss_samples = index_of_max_gaussian;
+
+  /* TEENSY PORT: sub-bin tempo refinement.
+     Fit a parabola through the autocorrelation peak at the winning
+     candidate lag and take its vertex. The denominator is negative at a
+     true maximum, so guarding on it also rejects flat or degenerate peaks.
+     Delta is clamped to +/-0.5 — a vertex further than half a bin means the
+     argmax was not really the peak.
+
+     The refined value is only trusted when it agrees with the smoothed
+     histogram argmax to within 1.5 bins; otherwise the histogram wins and
+     we snap. The EMA runs at the tempo tracking rate (86 Hz with
+     decimation 4), giving a time constant of roughly a quarter second —
+     long enough to average out per-frame autocorrelation jitter, short
+     enough to follow a genuine tempo change. */
+  {
+    int   L     = candidate_tempo_lags[index_of_max_score];
+    float refined = (float)L;
+
+    if((L > 0) && (L < self->oss_length - 1))
+      {
+        float ym1 = self->autocorrelation_real[L - 1];
+        float y0  = self->autocorrelation_real[L];
+        float yp1 = self->autocorrelation_real[L + 1];
+        float denom = ym1 - 2.0f * y0 + yp1;
+        if(denom < -1e-12f)
+          {
+            float delta = 0.5f * (ym1 - yp1) / denom;
+            if(delta >  0.5f) delta =  0.5f;
+            if(delta < -0.5f) delta = -0.5f;
+            refined += delta;
+          }
+      }
+
+    if((self->beat_period_oss_interp <= 0.0f) ||
+       (fabsf(refined - (float)index_of_max_gaussian) > 1.5f))
+      self->beat_period_oss_interp = (float)index_of_max_gaussian;
+    else
+      self->beat_period_oss_interp =
+        0.95f * self->beat_period_oss_interp + 0.05f * refined;
+  }
 }
 
